{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jevelopers.org/ProductionDerivationBinding/1.0.0",
  "title": "ProductionDerivationBinding",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "CompositionReference": {
      "allOf": [
        { "$ref": "https://schemas.jevelopers.org/ProductionReference/1.0.0#/$defs/Reference", "x-classification": "restricted" },
        { "type": "object", "properties": { "contract": { "const": "Composition", "x-classification": "public" }, "schema_version": { "const": "1.0.0", "x-classification": "public" } }, "required": ["contract", "schema_version"] }
      ],
      "x-classification": "restricted"
    }
  },
  "properties": {
    "contract": { "const": "ProductionDerivationBinding", "x-classification": "public" },
    "schema_version": { "const": "1.0.0", "x-classification": "public" },
    "policy_version": { "const": "1.0.0", "x-classification": "public" },
    "tenant_id": { "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/TenantId", "x-classification": "restricted" },
    "project_id": { "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/ProjectId", "x-classification": "restricted" },
    "association": { "$ref": "https://schemas.jevelopers.org/ProductionFieldReadBinding/1.0.0#/$defs/RowAssociation", "x-classification": "restricted" },
    "input_hash": { "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/Sha256", "x-classification": "restricted", "type": "string", "minLength": 71, "maxLength": 71 },
    "parent_ref": { "$ref": "https://schemas.jevelopers.org/ProductionDerivationBinding/1.0.0#/$defs/CompositionReference", "x-classification": "restricted" },
    "derived_ref": { "$ref": "https://schemas.jevelopers.org/ProductionDerivationBinding/1.0.0#/$defs/CompositionReference", "x-classification": "restricted" },
    "plan_hash": { "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/Sha256", "x-classification": "restricted", "type": "string", "minLength": 71, "maxLength": 71 },
    "policy_ref": {
      "allOf": [
        { "$ref": "https://schemas.jevelopers.org/ProductionReference/1.0.0#/$defs/Reference", "x-classification": "restricted" },
        { "type": "object", "properties": { "contract": { "const": "ProductionPolicy", "x-classification": "public" }, "schema_version": { "const": "1.0.0", "x-classification": "public" } }, "required": ["contract", "schema_version"] }
      ],
      "x-classification": "restricted"
    },
    "policy_hash": { "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/Sha256", "x-classification": "restricted", "type": "string", "minLength": 71, "maxLength": 71 },
    "report_ref": {
      "allOf": [
        { "$ref": "https://schemas.jevelopers.org/ProductionReference/1.0.0#/$defs/Reference", "x-classification": "restricted" },
        { "type": "object", "properties": { "contract": { "const": "PreflightReport", "x-classification": "public" }, "schema_version": { "const": "1.0.0", "x-classification": "public" } }, "required": ["contract", "schema_version"] }
      ],
      "x-classification": "restricted"
    },
    "report_hash": { "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/Sha256", "x-classification": "restricted", "type": "string", "minLength": 71, "maxLength": 71 },
    "resource_commitments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "resource_ref": {
            "allOf": [
              { "$ref": "https://schemas.jevelopers.org/ProductionReference/1.0.0#/$defs/Reference", "x-classification": "restricted" },
              { "type": "object", "properties": { "contract": { "const": "ProductionResource", "x-classification": "public" }, "schema_version": { "const": "1.0.0", "x-classification": "public" } }, "required": ["contract", "schema_version"] }
            ],
            "x-classification": "restricted"
          },
          "resource_hash": { "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/Sha256", "x-classification": "restricted", "type": "string", "minLength": 71, "maxLength": 71 }
        },
        "required": ["resource_ref", "resource_hash"],
        "x-classification": "restricted"
      },
      "minItems": 0,
      "maxItems": 32,
      "x-classification": "restricted"
    },
    "runtime_ref": {
      "allOf": [
        { "$ref": "https://schemas.jevelopers.org/ProductionReference/1.0.0#/$defs/Reference", "x-classification": "restricted" },
        { "type": "object", "properties": { "contract": { "const": "ProductionRuntime", "x-classification": "public" }, "schema_version": { "const": "1.0.0", "x-classification": "public" } }, "required": ["contract", "schema_version"] }
      ],
      "x-classification": "restricted"
    },
    "runtime_hash": { "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/Sha256", "x-classification": "restricted", "type": "string", "minLength": 71, "maxLength": 71 },
    "change_classification": { "type": "string", "enum": ["mechanical_only", "material", "unknown"], "x-classification": "restricted" },
    "binding_hash": { "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/Sha256", "x-classification": "restricted", "type": "string", "minLength": 71, "maxLength": 71 }
  },
  "required": ["contract", "schema_version", "policy_version", "tenant_id", "project_id", "association", "input_hash", "parent_ref", "derived_ref", "plan_hash", "policy_ref", "policy_hash", "report_ref", "report_hash", "resource_commitments", "runtime_ref", "runtime_hash", "change_classification", "binding_hash"],
  "x-classification": "restricted"
}
