{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jevelopers.org/ProductionDraftBatchResult/1.0.0",
  "title": "ProductionDraftBatchResult",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "CountObservation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": { "state": { "const": "known", "x-classification": "public" }, "value": { "type": "integer", "minimum": 0, "maximum": 10000, "x-classification": "restricted" } },
          "required": ["state", "value"],
          "x-classification": "restricted"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": { "state": { "const": "unknown", "x-classification": "public" } },
          "required": ["state"],
          "x-classification": "restricted"
        }
      ],
      "x-classification": "restricted"
    }
  },
  "properties": {
    "contract": { "const": "ProductionDraftBatchResult", "x-classification": "public" },
    "schema_version": { "const": "1.0.0", "x-classification": "public" },
    "policy_version": { "const": "1.0.0", "x-classification": "public" },
    "tenant_id": { "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/TenantId", "x-classification": "restricted" },
    "project_id": { "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/ProjectId", "x-classification": "restricted" },
    "job": { "$ref": "https://schemas.jevelopers.org/JobRef/1.0.0", "x-classification": "restricted" },
    "acceptance_policy": { "type": "string", "enum": ["atomic", "allow_partial"], "x-classification": "restricted" },
    "status": { "type": "string", "enum": ["queued", "running", "succeeded", "failed", "cancelled", "partially_succeeded", "unknown"], "x-classification": "restricted" },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "submitted": { "$ref": "https://schemas.jevelopers.org/ProductionDraftBatchResult/1.0.0#/$defs/CountObservation", "x-classification": "restricted" },
        "succeeded": { "$ref": "https://schemas.jevelopers.org/ProductionDraftBatchResult/1.0.0#/$defs/CountObservation", "x-classification": "restricted" },
        "failed": { "$ref": "https://schemas.jevelopers.org/ProductionDraftBatchResult/1.0.0#/$defs/CountObservation", "x-classification": "restricted" },
        "cancelled": { "$ref": "https://schemas.jevelopers.org/ProductionDraftBatchResult/1.0.0#/$defs/CountObservation", "x-classification": "restricted" },
        "skipped": { "$ref": "https://schemas.jevelopers.org/ProductionDraftBatchResult/1.0.0#/$defs/CountObservation", "x-classification": "restricted" },
        "pending": { "$ref": "https://schemas.jevelopers.org/ProductionDraftBatchResult/1.0.0#/$defs/CountObservation", "x-classification": "restricted" },
        "published": { "$ref": "https://schemas.jevelopers.org/ProductionDraftBatchResult/1.0.0#/$defs/CountObservation", "x-classification": "restricted" }
      },
      "required": ["submitted", "succeeded", "failed", "cancelled", "skipped", "pending", "published"],
      "x-classification": "restricted"
    },
    "publication_state": { "type": "string", "enum": ["published", "unpublished", "unknown"], "x-classification": "restricted" },
    "visibility": { "const": "restricted_draft", "x-classification": "public" },
    "rows": { "type": "array", "items": { "$ref": "https://schemas.jevelopers.org/ProductionDraftRowResult/1.0.0", "x-classification": "restricted" }, "minItems": 0, "maxItems": 10000, "x-classification": "restricted" }
  },
  "required": ["contract", "schema_version", "policy_version", "tenant_id", "project_id", "job", "acceptance_policy", "status", "counts", "publication_state", "visibility", "rows"],
  "x-classification": "restricted"
}
