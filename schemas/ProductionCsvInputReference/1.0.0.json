{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jevelopers.org/ProductionCsvInputReference/1.0.0",
  "title": "ProductionCsvInputReference",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract": { "const": "ProductionCsvInputReference", "x-classification": "public" },
    "schema_version": { "const": "1.0.0", "x-classification": "public" },
    "policy_version": { "const": "1.0.0", "x-classification": "public" },
    "tenant_id": { "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/TenantId", "x-classification": "restricted" },
    "project_id": { "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/ProjectId", "x-classification": "restricted" },
    "id": { "type": "string", "format": "uuid", "minLength": 36, "maxLength": 36, "x-classification": "restricted" },
    "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991, "x-classification": "restricted" },
    "content_hash": { "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/Sha256", "x-classification": "restricted", "type": "string", "minLength": 71, "maxLength": 71 },
    "byte_hash": { "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/Sha256", "x-classification": "restricted", "type": "string", "minLength": 71, "maxLength": 71 },
    "byte_size": { "type": "integer", "minimum": 1, "maximum": 67108864, "x-classification": "restricted" },
    "media_type": { "const": "text/csv", "x-classification": "public" }
  },
  "required": ["contract", "schema_version", "policy_version", "tenant_id", "project_id", "id", "revision", "content_hash", "byte_hash", "byte_size", "media_type"],
  "x-classification": "restricted"
}
