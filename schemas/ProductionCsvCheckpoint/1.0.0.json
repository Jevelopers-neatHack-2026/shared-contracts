{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jevelopers.org/ProductionCsvCheckpoint/1.0.0",
  "title": "ProductionCsvCheckpoint",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "ProductionCsvInputPolicyReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract": { "const": "ProductionCsvInputPolicy", "x-classification": "public" },
        "schema_version": { "const": "1.0.0", "x-classification": "public" },
        "id": { "type": "string", "format": "uuid", "minLength": 36, "maxLength": 36, "x-classification": "restricted" },
        "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991, "x-classification": "restricted" },
        "content_hash": { "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/Sha256", "x-classification": "restricted", "type": "string", "minLength": 71, "maxLength": 71 }
      },
      "required": ["contract", "schema_version", "id", "revision", "content_hash"],
      "x-classification": "restricted"
    }
  },
  "properties": {
    "contract": { "const": "ProductionCsvCheckpoint", "x-classification": "public" },
    "schema_version": { "const": "1.0.0", "x-classification": "public" },
    "policy_version": { "const": "1.0.0", "x-classification": "public" },
    "tenant_id": { "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/TenantId", "x-classification": "restricted" },
    "project_id": { "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/ProjectId", "x-classification": "restricted" },
    "id": { "type": "string", "format": "uuid", "minLength": 36, "maxLength": 36, "x-classification": "restricted" },
    "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991, "x-classification": "restricted" },
    "content_hash": { "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/Sha256", "x-classification": "restricted", "type": "string", "minLength": 71, "maxLength": 71 },
    "input_ref": { "$ref": "https://schemas.jevelopers.org/ProductionCsvInputReference/1.0.0", "x-classification": "restricted" },
    "dialect_ref": {
      "allOf": [
        { "$ref": "https://schemas.jevelopers.org/ProductionReference/1.0.0#/$defs/Reference", "x-classification": "restricted" },
        { "type": "object", "properties": { "contract": { "const": "CsvDialect", "x-classification": "public" }, "schema_version": { "const": "1.0.0", "x-classification": "public" } }, "required": ["contract", "schema_version"] }
      ],
      "x-classification": "restricted"
    },
    "mapping_ref": {
      "allOf": [
        { "$ref": "https://schemas.jevelopers.org/ProductionReference/1.0.0#/$defs/Reference", "x-classification": "restricted" },
        { "type": "object", "properties": { "contract": { "const": "CsvMapping", "x-classification": "public" }, "schema_version": { "const": "1.0.0", "x-classification": "public" } }, "required": ["contract", "schema_version"] }
      ],
      "x-classification": "restricted"
    },
    "input_policy_ref": { "$ref": "https://schemas.jevelopers.org/ProductionCsvCheckpoint/1.0.0#/$defs/ProductionCsvInputPolicyReference", "x-classification": "restricted" },
    "input_policy_hash": { "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/Sha256", "x-classification": "restricted", "type": "string", "minLength": 71, "maxLength": 71 },
    "byte_offset": { "type": "integer", "minimum": 1, "maximum": 67108864, "x-classification": "restricted" },
    "logical_record": { "type": "integer", "minimum": 1, "maximum": 10000, "x-classification": "restricted" },
    "physical_line": { "type": "integer", "minimum": 1, "maximum": 9007199254740991, "x-classification": "restricted" },
    "complete_record": { "const": true, "x-classification": "public" }
  },
  "required": ["contract", "schema_version", "policy_version", "tenant_id", "project_id", "id", "revision", "content_hash", "input_ref", "dialect_ref", "mapping_ref", "input_policy_ref", "input_policy_hash", "byte_offset", "logical_record", "physical_line", "complete_record"],
  "x-classification": "restricted"
}
